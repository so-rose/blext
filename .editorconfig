[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

indent_style = tab
indent_size = 4
trim_trailing_whitespace = false

[*.typ]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[*.rs]
indent_style = tab
indent_size = 4

[*.py]
indent_style = tab
indent_size = 4
